PORT=5000
# MongoDB Atlas free cluster (M0) connection string
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/slice-and-crust?retryWrites=true&w=majority
JWT_SECRET=replace-with-random-long-string-at-least-32-chars
JWT_EXPIRE=7d
# Frontend URL(s) allowed by CORS, comma separated
CLIENT_URL=http://localhost:5173
# The admin account is created automatically on first start
ADMIN_EMAIL=admin@sliceandcrust.com
ADMIN_PASSWORD=change-me

# Optional: Razorpay TEST keys (no real money). Leave empty to allow Cash on Delivery only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: Cloudinary for admin image uploads. Leave empty to paste image URLs instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: only if your local network can't resolve Atlas SRV records
# DNS_SERVERS=8.8.8.8,1.1.1.1
